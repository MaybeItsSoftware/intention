# Intention backend configuration.
# Copy to server/.env and fill in, or set these in your host's env panel.

# --- Required ---------------------------------------------------------------

# Signs the entitlement tokens clients authenticate coaching calls with.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTENTION_TOKEN_SECRET=

# The provider key the hosted coach runs on. This is the key Apple's guideline
# 3.1.1 requires us to hold instead of asking users for one.
INTENTION_LLM_API_KEY=
INTENTION_LLM_PROVIDER=anthropic
INTENTION_LLM_MODEL=claude-sonnet-5

# --- Apple (App Store Server API) -------------------------------------------
# App Store Connect -> Users and Access -> Integrations -> In-App Purchase key.
APPLE_BUNDLE_ID=uk.co.maybeitssoftware.intention
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 'sandbox' while testing with a sandbox Apple Account, 'production' when live.
APPLE_ENVIRONMENT=production

# --- Google (Play Developer API) --------------------------------------------
# Service account JSON from Google Cloud, granted access in Play Console.
# Use a separate, read-only ("View financial data" only) service account here
# — not the release-capable one CI uses to publish builds.
GOOGLE_PACKAGE_NAME=uk.co.maybeitssoftware.intention
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Optional ---------------------------------------------------------------

PORT=8787
# How long an entitlement token stays valid before the client re-verifies.
# Long-lived is fine: a token only proves "known purchaser," balance is always
# looked up live, so nothing can be "renewed away" the way a subscription
# token could be. Defaults to 180 days.
INTENTION_TOKEN_TTL_MS=15552000000

# The three coaching-credit top-up tiers: "amountGbp:appleProductId:googleProductId,...".
# Defaults to £1/£2/£5 matching uk.co.maybeitssoftware.intention.coach.credit{1,2,5}
# and intention_coach_credit_{1,2,5} — only set this if those product IDs differ.
# INTENTION_TOPUPS=1:uk.co.maybeitssoftware.intention.coach.credit1:intention_coach_credit_1,2:...,5:...

# Static USD->GBP conversion used to turn LLM token cost into a GBP deduction.
# Hand-reviewed occasionally, not a live feed. Defaults to 0.79.
# INTENTION_USD_TO_GBP_RATE=0.79

# Multiplier applied to the cost side of every deduction (not to a top-up's
# credited value) — a small buffer against LLM price drift, not a margin play.
# Defaults to 1.15.
# INTENTION_MARGIN_MULTIPLIER=1.15

# Local development only: accept receipts without checking them with the store.
# Ignored unless NODE_ENV=development. Never set this in production.
# INTENTION_ALLOW_UNVERIFIED_RECEIPTS=1
