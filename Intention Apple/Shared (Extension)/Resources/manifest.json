{
  "manifest_version": 3,
  "name": "Intention",
  "version": "0.24.0",
  "description": "Focus gate for distracting sites. Explain each visit, set daily limits, and see where your time goes.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "parts.js",
        "page_context.js",
        "report.js",
        "rules.js",
        "gate-ui.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "coaching.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Intention Settings"
  },
  "background": {
    "scripts": [
      "parts.js",
      "sites.js",
      "providers.js",
      "prompts.js",
      "tracking.js",
      "page_context.js",
      "rules.js",
      "background.js"
    ],
    "persistent": false
  }
}
