# Release lanes for Intention's Safari App Extension wrapper (iOS + macOS).
#
#   bundle exec fastlane ios beta      # build IPA   -> upload to App Store Connect
#   bundle exec fastlane mac beta      # build PKG   -> upload to App Store Connect
#   bundle exec fastlane mac local     # build .app, Developer ID sign + notarize -> /Applications
#
# Auth is via an App Store Connect API key and fastlane match, both shared
# with the rest of the maybeitssoftware apps (same Apple team, 6NQNU5YSC2) —
# mirrors the open-parliament repo's setup.

ROOT = File.expand_path("..", __dir__)

# Secrets live in the repo root .env (same place as the Chrome/Firefox store
# credentials), not fastlane's own fastlane/.env, so load it explicitly.
require "dotenv"
Dotenv.load(File.join(ROOT, "..", ".env"))

PROJECT = File.join(ROOT, "Intention Safari.xcodeproj")
TEAM_ID = ENV["TEAM_ID"] || "6NQNU5YSC2"

# target name -> bundle identifier, split by platform since macOS only
# embeds one extension while iOS embeds five.
IOS_TARGETS = {
  "Intention Safari (iOS)"            => "uk.co.maybeitssoftware.intention",
  "Intention Safari Extension (iOS)"  => "uk.co.maybeitssoftware.intention.Extension",
  "Intention Monitor Extension"       => "uk.co.maybeitssoftware.intention.Monitor",
  "Intention Shield Extension"        => "uk.co.maybeitssoftware.intention.Shield",
  "Intention Shield Action Extension" => "uk.co.maybeitssoftware.intention.ShieldAction",
  "Intention Report Extension"        => "uk.co.maybeitssoftware.intention.Report",
}
MACOS_TARGETS = {
  "Intention Safari (macOS)"           => "uk.co.maybeitssoftware.intention",
  "Intention Safari Extension (macOS)" => "uk.co.maybeitssoftware.intention.Extension",
}

def asc_api_key
  app_store_connect_api_key(
    key_id:                ENV["ASC_KEY_ID"],
    issuer_id:             ENV["ASC_ISSUER_ID"],
    key_content:           ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true,
  )
end

# match names macOS profiles "match AppStore <bundle id> macos" (suffixed) to
# disambiguate from the iOS profile sharing the same bundle ID — don't guess
# the name, read it back from what match actually created.
def apply_manual_signing(target_map, code_sign_identity:)
  mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
  target_map.each do |target, bundle_id|
    update_code_signing_settings(
      path:                  PROJECT,
      use_automatic_signing: false,
      team_id:               TEAM_ID,
      code_sign_identity:    code_sign_identity,
      bundle_identifier:     bundle_id,
      targets:               [target],
      profile_name:          mapping.fetch(bundle_id),
    )
  end
end

def write_export_options(path, bundle_ids)
  mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
  options = {
    "method"                => "app-store",
    "teamID"                => TEAM_ID,
    "uploadSymbols"         => true,
    "signingStyle"          => "manual",
    "provisioningProfiles"  => bundle_ids.to_h { |id| [id, mapping.fetch(id)] },
  }
  require "plist"
  File.write(path, options.to_plist)
end

platform :ios do
  desc "Build a signed release IPA and upload it to App Store Connect"
  lane :beta do
    setup_ci # no-op locally; on CI, uses a temp keychain and forces match readonly
    api_key = asc_api_key

    match(
      type:           "appstore",
      platform:       "ios",
      app_identifier: IOS_TARGETS.values,
      api_key:        api_key,
      # Only CI is forbidden from creating new profiles/certs — a local run
      # (e.g. adding a new bundle ID) still needs write access.
      readonly:       is_ci,
    )

    apply_manual_signing(IOS_TARGETS, code_sign_identity: "Apple Distribution")

    export_options = File.join(ROOT, "ExportOptions-ios.plist")
    write_export_options(export_options, IOS_TARGETS.values)

    build_app(
      project:            PROJECT,
      scheme:             "Intention Safari (iOS)",
      export_method:      "app-store",
      export_options:     export_options,
      output_directory:   File.join(ROOT, "..", "build", "ios"),
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
    )
  end
end

platform :mac do
  # Shared by both mac lanes: signs with the real "Apple Distribution" /
  # "Mac Installer Distribution" certs on the paid team (6NQNU5YSC2), not a
  # 7-day personal-team dev profile — so the resulting .pkg keeps working
  # indefinitely, unlike an Xcode Run build.
  private_lane :build_signed_pkg do
    setup_ci # no-op locally; on CI, uses a temp keychain and forces match readonly
    api_key = asc_api_key

    match(
      type:                 "appstore",
      platform:             "macos",
      app_identifier:       MACOS_TARGETS.values,
      api_key:              api_key,
      readonly:             is_ci,
      # macOS App Store export packages the signed .app into a .pkg, which
      # needs a separate "Mac Installer Distribution" cert beyond the
      # "Apple Distribution" one used to sign the .app itself.
      additional_cert_types: ["mac_installer_distribution"],
    )

    apply_manual_signing(MACOS_TARGETS, code_sign_identity: "Apple Distribution")

    export_options = File.join(ROOT, "ExportOptions-macos.plist")
    write_export_options(export_options, MACOS_TARGETS.values)

    build_app(
      project:            PROJECT,
      scheme:             "Intention Safari (macOS)",
      export_method:      "app-store",
      export_options:     export_options,
      output_directory:   File.join(ROOT, "..", "build", "macos"),
    )

    api_key
  end

  desc "Build a signed release PKG and upload it to App Store Connect"
  lane :beta do
    api_key = build_signed_pkg

    upload_to_testflight(
      api_key:                           api_key,
      pkg:                               lane_context[SharedValues::PKG_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build a signed .app and install it to /Applications on this Mac"
  lane :local do
    setup_ci
    api_key = asc_api_key

    # An "appstore" provisioning profile only validates when launched through
    # an actual Mac App Store install — macOS refuses to run a sideloaded
    # .pkg signed with it ("No matching profile found" in the amfid log).
    #
    # "developer_id" (Apple's mechanism for direct distribution outside the
    # store) was tried first, but creating that certificate via API key is
    # restricted by Apple to the team's Account Holder specifically — our
    # Admin-level ASC key gets "This operation can only be performed by the
    # Account Holder." So: sign with an ordinary "Apple Development"
    # certificate instead. It's tied to the paid team (~1 year validity, not
    # the 7-day free-account expiry) and, since the build is copied locally
    # rather than downloaded, never picks up the quarantine flag that would
    # otherwise require Gatekeeper/notarization.
    # A macOS development profile needs at least one registered Mac attached.
    # Apple Silicon Macs report a "Provisioning UDID" distinct from their
    # Hardware UUID — the Dev Portal wants the former, not the latter.
    register_device(
      name:      ENV["HOST"] || `scutil --get ComputerName`.strip,
      udid:      `system_profiler SPHardwareDataType | awk -F': ' '/Provisioning UDID/ {print $2}'`.strip,
      team_id:   TEAM_ID,
      api_key:   api_key,
    )

    match(
      type:                 "development",
      platform:             "macos",
      app_identifier:       MACOS_TARGETS.values,
      api_key:              api_key,
      readonly:             is_ci,
      # Regenerate the profile if the device list changed since it was last
      # created (e.g. this Mac was just registered above).
      force_for_new_devices: true,
    )

    apply_manual_signing(MACOS_TARGETS, code_sign_identity: "Apple Development")

    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    export_options = File.join(ROOT, "ExportOptions-macos-local.plist")
    options = {
      "method"               => "development",
      "teamID"               => TEAM_ID,
      "signingStyle"         => "manual",
      "provisioningProfiles" => MACOS_TARGETS.values.to_h { |id| [id, mapping.fetch(id)] },
    }
    require "plist"
    File.write(export_options, options.to_plist)

    app_path = build_app(
      project:            PROJECT,
      scheme:             "Intention Safari (macOS)",
      export_method:      "development",
      export_options:     export_options,
      output_directory:   File.join(ROOT, "..", "build", "macos-local"),
      skip_package_pkg:   true,
    )

    dest = "/Applications/Intention.app"
    sh("rm -rf #{dest.shellescape} && cp -R #{app_path.shellescape} #{dest.shellescape}")
    UI.success("Installed build to #{dest}")
  end
end
