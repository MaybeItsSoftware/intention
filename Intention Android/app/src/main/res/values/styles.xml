<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Intention" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">#0f1115</item>
        <item name="colorAccent">#e7e7ea</item>
    </style>

    <!-- Fullscreen Coaching Theme. System bars are hidden in code via
         WindowInsetsControllerCompat (CoachingActivity) rather than the legacy
         android:windowFullscreen flag, which conflicts with SDK 35+ edge-to-edge
         enforcement. -->
    <style name="Theme.Intention.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#0f1115</item>
    </style>
</resources>
